{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://yesdhobi-alb-648458477.ap-southeast-2.elb.amazonaws.com/api/v1/:path*"
    },
    {
      "source": "/webhook/:path*",
      "destination": "http://yesdhobi-alb-648458477.ap-southeast-2.elb.amazonaws.com/webhook/:path*"
    },
    {
      "source": "/vendoronboarding",
      "destination": "https://yes-dhobi.vercel.app/vendoronboarding/"
    },
    {
      "source": "/vendoronboarding/:path*",
      "destination": "https://yes-dhobi.vercel.app/vendoronboarding/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/partner",
      "destination": "/vendoronboarding",
      "permanent": true
    },
    {
      "source": "/partner/:path*",
      "destination": "/vendoronboarding/:path*",
      "permanent": true
    },
    {
      "source": "/partners",
      "destination": "/vendoronboarding",
      "permanent": true
    },
    {
      "source": "/partners/:path*",
      "destination": "/vendoronboarding/:path*",
      "permanent": true
    }
  ]
}
